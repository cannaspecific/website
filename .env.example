# Postgres connection string. Neon and most hosted Postgres providers
# require SSL. The server enables SSL automatically unless the host is
# localhost or you set DATABASE_SSL=disable.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Local Postgres only. Do not set this on Render.
# DATABASE_SSL=disable

# SendGrid. Mail is skipped (and the failure is logged) when either value
# is missing. The from-address MUST be a verified single sender, or an
# address on the domain authenticated in SendGrid.
#
# DNS for this project currently authenticates the www host, not the apex:
#   em17.www.cannaspecific.com
#   s1._domainkey.www.cannaspecific.com
#   s2._domainkey.www.cannaspecific.com
# Until the apex domain cannaspecific.com is authenticated, use a from
# address on www.cannaspecific.com, for example:
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@www.cannaspecific.com
SENDGRID_FROM_NAME=CannaSpecific

# Inbox that receives a copy of every new signup and pilot inquiry.
# Defaults to cannaspecific@gmail.com when unset.
NOTIFY_EMAIL=cannaspecific@gmail.com

# Long random string. Required for /admin and the CSV export.
# Generate one with: openssl rand -base64 32
ADMIN_TOKEN=

# Optional. The server listens on 0.0.0.0:$PORT. Render sets PORT.
# PORT=5000

# Optional in-memory rate limit for the two forms. Defaults: 8 requests
# per 10 minutes per IP. Resets when the free-tier instance sleeps.
# RATE_LIMIT_MAX=8
# RATE_LIMIT_WINDOW_MS=600000
